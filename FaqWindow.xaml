<Window x:Class="SnakeGame.FaqWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SnakeGame"
        mc:Ignorable="d"
        Title="Об игре и разработчиках" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Image Source="Assets/Images/faq-background.jpg" Stretch="Fill"/>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,4,0,10">
                <Image Source="Assets/Images/faq-easy.png" Height="72" Margin="0,0,16,0"/>
                <Image Source="Assets/Images/faq-decoration.png" Height="72"/>
            </StackPanel>

            <Border Grid.Row="1" Grid.Column="0" BorderBrush="White" BorderThickness="1"
                    Margin="0,0,8,60">
                <TextBlock TextWrapping="Wrap" Margin="12" Foreground="White"
                           VerticalAlignment="Top"><Run Text="Змейка — классическая игра, в которой игрок управляет змейкой: она ползает по полю, поедает еду и растет. Цель — съесть как можно больше еды, не столкнувшись со стеной или собственным хвостом."/><LineBreak/><LineBreak/><Run Text="Управление: стрелки или WASD, Esc — пауза."/><LineBreak/><LineBreak/><Run FontWeight="Bold" Text="Для победы нужно набрать 10 очков!"/></TextBlock>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" BorderBrush="White" BorderThickness="1"
                    Margin="8,0,0,60">
                <TextBlock TextWrapping="Wrap" Margin="12" Foreground="White"
                           VerticalAlignment="Top"><Run Text="Команда разработчиков:"/><LineBreak/><Run Text="Руш Егор"/><LineBreak/><Run Text="Андреев Александр"/><LineBreak/><Run Text="Довыденко Татьяна"/><LineBreak/><Run Text="Пфайфер Антон"/><LineBreak/><Run Text="Семенов Андрей"/></TextBlock>
            </Border>

            <Button Grid.Row="1" Grid.ColumnSpan="2" Content="МЕНЮ"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Padding="20,6" Click="MenuButton_Click"
                    FontFamily="Segoe Script" FontSize="20" FontWeight="Bold"/>
        </Grid>
    </Grid>
</Window>
