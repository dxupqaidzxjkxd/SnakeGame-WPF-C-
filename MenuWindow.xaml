<Window x:Class="SnakeGame.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SnakeGame"
        mc:Ignorable="d"
        Title="Snake Game" Height="500" Width="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="73*"/>
            <RowDefinition Height="261*"/>
        </Grid.RowDefinitions>

        <Image Grid.RowSpan="2" Source="Assets/Images/menu-background.png" Stretch="Fill"/>

        <Label Content="SNAKE GAME" HorizontalAlignment="Center" FontSize="48"
               Margin="0,13,0,0" VerticalAlignment="Top" FontWeight="Bold"
               FontFamily="Comic Sans MS" Foreground="#FFFFEA00"/>
        <Label Content="выберите уровень сложности" HorizontalAlignment="Center"
               Margin="0,78,0,0" VerticalAlignment="Top" FontFamily="Bauhaus 93"
               FontSize="24" Grid.RowSpan="2" Foreground="White"/>

        <!-- Колонки сложности: картинка + кнопка, без магических пиксельных отступов -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="14,37,14,20">
            <Border BorderBrush="#FF00FF04" BorderThickness="2" Margin="0,0,8,0">
                <Grid>
                    <Image Source="Assets/Images/menu-snake.png" Stretch="Uniform" Margin="4"/>
                    <Button Content="EASY" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                            Margin="0,0,0,12" Padding="16,6" FontWeight="Bold" FontStyle="Italic"
                            FontFamily="Kristen ITC" FontSize="14"
                            Background="#FF45D65C" BorderBrush="Black" Click="EasyButton_Click"/>
                </Grid>
            </Border>
            <Border BorderBrush="#FFDAFF00" BorderThickness="2" Margin="8,0,8,0">
                <Grid>
                    <Image Source="Assets/Images/menu-play.png" Stretch="Uniform" Margin="4"/>
                    <Button Content="NORMAL" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                            Margin="0,0,0,12" Padding="16,6" FontWeight="Bold" FontStyle="Italic"
                            FontFamily="Kristen ITC" FontSize="14"
                            Background="#FFD9F534" BorderBrush="Black" Click="NormalButton_Click"/>
                </Grid>
            </Border>
            <Border BorderBrush="#FF9E0505" BorderThickness="2" Margin="8,0,0,0">
                <Grid>
                    <Image Source="Assets/Images/menu-faq.png" Stretch="Uniform" Margin="4"/>
                    <Button Content="HARD" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                            Margin="0,0,0,12" Padding="16,6" FontWeight="Bold" FontStyle="Italic"
                            FontFamily="Kristen ITC" FontSize="14"
                            Background="#FFCC1B1B" BorderBrush="Black" Click="HardButton_Click"/>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Рекорды по сложностям -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock x:Name="BestEasyText" Text="EASY: -" Foreground="White"
                       FontSize="14" Margin="0,0,24,0"/>
            <TextBlock x:Name="BestNormalText" Text="NORMAL: -" Foreground="White"
                       FontSize="14" Margin="0,0,24,0"/>
            <TextBlock x:Name="BestHardText" Text="HARD: -" Foreground="White" FontSize="14"/>
        </StackPanel>

        <Button Content="FAQ" HorizontalAlignment="Left" Margin="28,31,0,0"
                VerticalAlignment="Top" Click="FaqButton_Click"
                FontFamily="Segoe Script" FontSize="18" Padding="12,4"
                BorderBrush="Black" FontWeight="Bold">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF85E0A4"/>
                    <GradientStop Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <Button Content="EXIT" HorizontalAlignment="Right" Margin="0,31,28,0"
                VerticalAlignment="Top" Click="ExitButton_Click" Padding="12,4"
                FontSize="18" FontFamily="Segoe Script" FontWeight="Bold">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF85E0A4"/>
                    <GradientStop Color="{DynamicResource {x:Static SystemColors.ActiveCaptionColorKey}}" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
    </Grid>
</Window>
