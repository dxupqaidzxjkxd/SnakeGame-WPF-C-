<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\Images\icon.ico</ApplicationIcon>
    <RootNamespace>SnakeGame</RootNamespace>
  </PropertyGroup>

  <!-- Все картинки/шрифты из Assets/Images автоматически становятся ресурсами -->
  <ItemGroup>
    <Resource Include="Assets\Images\**" />
  </ItemGroup>

  <!-- Файлы музыки (кладутся рядом с exe в папку Sound) копируются в выходной каталог -->
  <ItemGroup>
    <None Include="Sound\**" CopyToOutputDirectory="PreserveNewest" Pack="false" />
  </ItemGroup>

</Project>
