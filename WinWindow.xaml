<Window x:Class="SnakeGame.WinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SnakeGame"
        mc:Ignorable="d"
        Title="Победа!" Height="466" Width="646"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">
    <Grid>
        <Image Source="Assets/Images/win-background.jpg" Stretch="Fill"/>

        <TextBlock Margin="16,16,16,0" VerticalAlignment="Top" TextWrapping="Wrap"
                   FontWeight="Bold" FontFamily="Segoe Script" Foreground="White">
            <Run FontSize="18" Text="Поздравляем с победой!"/><LineBreak FontSize="18"/><LineBreak FontSize="18"/>
            <Run x:Name="ScoreRun" FontSize="18" Text="Ваш результат: 0 очков."/><LineBreak/>
            <Run FontSize="18" Text="Вы один(а) из немногих, кто прошел этот этап."/><LineBreak/><LineBreak/>
            <Run FontSize="18" Text="Не забывайте о своем достижении."/><LineBreak/>
            <Run FontSize="18" Text="А сейчас можете отдохнуть..."/>
        </TextBlock>

        <TextBlock Margin="16,0,16,64" VerticalAlignment="Bottom" TextWrapping="Wrap"
                   HorizontalAlignment="Right" MaxWidth="320" Foreground="White"
                   FontSize="14"><Run Text="별은 바라보는 사람에게 빛을 준다 — Звёзды светят тем, кто на них смотрит."/></TextBlock>

        <Button Content="Меню" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,16" Padding="24,6" Click="MenuButton_Click"
                FontFamily="Segoe Script" FontSize="20" FontWeight="Bold"/>
    </Grid>
</Window>
